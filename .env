# --- Required ---
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcn-...
PINECONE_INDEX=pdf-rag-index

# --- Optional ---
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Retrieval
TOP_K=6
SCORE_THRESHOLD=0.25  # 0..1 normalized cosine similarity

# Pinecone
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
